@model QuanLyBaiDoXe_UNETI.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard & Thống kê";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Dashboard & Thống Kê Báo Cáo
        </h3>
        <p class="text-muted mb-0 small">Theo dõi tổng quan công suất bãi đỗ, phân bố phương tiện và doanh thu hệ thống</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="XuatBaoCaoExcel" class="btn btn-success px-3 py-2 shadow-sm fw-semibold d-inline-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-excel-fill"></i>
            <span>Xuất Báo Cáo Excel</span>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">TỔNG DOANH THU</span>
                    <h3 class="fw-bold text-success mt-2 mb-0">@Model.TongDoanhThu.ToString("N0") <small class="fs-6">đ</small></h3>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">XE ĐANG GỬI</span>
                    <h3 class="fw-bold text-primary mt-2 mb-0">@Model.SoXeDangGui / @Model.TongSoViTri</h3>
                    <small class="text-muted">Trống: <strong class="text-success">@Model.SoViTriTrong</strong> vị trí</small>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-p-square fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">PHIẾU CHỜ DUYỆT</span>
                    <h3 class="fw-bold text-warning mt-2 mb-0">@Model.SoPhieuChoXacNhan</h3>
                    <small class="text-muted">Tổng số: @Model.TongSoPhieu lượt</small>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">PHƯƠNG TIỆN / CHỦ XE</span>
                    <h3 class="fw-bold text-dark mt-2 mb-0">@Model.TongSoXe <small class="fs-6 text-muted">xe</small></h3>
                    <small class="text-muted">Từ <strong>@Model.TongSoChuXe</strong> chủ phương tiện</small>
                </div>
                <div class="p-3 bg-secondary-subtle text-secondary rounded-circle">
                    <i class="bi bi-bicycle fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Biểu Đồ Doanh Thu Theo Tháng (VNĐ)
                </h6>
                <small class="text-muted">Cập nhật tự động</small>
            </div>
            <div class="card-body p-3">
                <canvas id="revenueChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-pie-chart-fill text-info me-2"></i>Tỷ Lệ Phương Tiện Theo Loại
                </h6>
                <small class="text-muted">Cơ cấu xe</small>
            </div>
            <div class="card-body p-3 d-flex align-items-center justify-content-center">
                <div style="width: 100%; max-width: 260px;">
                    <canvas id="vehicleTypeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar3 text-primary me-2"></i>Bảng Doanh Thu Chi Tiết Theo Tháng</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tháng / Năm</th>
                                <th>Số lượt gửi xe</th>
                                <th class="text-end pe-4">Tổng doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DoanhThuTheoThang.Any())
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">Chưa có lượt gửi nào hoàn tất thu tiền.</td></tr>
                            }
                            @foreach (var dt in Model.DoanhThuTheoThang)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">Tháng @dt.Thang / @dt.Nam</td>
                                    <td><span class="badge bg-light text-dark border">@dt.SoLuotGui lượt</span></td>
                                    <td class="text-end pe-4 fw-bold text-success">@dt.TongTien.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-trophy text-warning me-2"></i>Top Vị Trí Đỗ Được Dùng Nhiều Nhất</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Vị trí</th>
                                <th>Khu vực - Tầng</th>
                                <th class="text-end pe-4">Lượt đỗ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ThongKeTheoViTri.Any())
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu lượt đỗ.</td></tr>
                            }
                            @foreach (var vt in Model.ThongKeTheoViTri)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@vt.TenViTri</td>
                                    <td class="small text-muted">@vt.KhuVuc - Tầng @vt.Tang</td>
                                    <td class="text-end pe-4"><span class="badge bg-primary-subtle text-primary fw-bold">@vt.SoLuotSuDung lượt</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-table text-info me-2"></i>Chi Tiết Doanh Thu & Lượt Gửi Theo Từng Loại Xe</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tên loại xe</th>
                        <th>Tổng số xe đăng ký</th>
                        <th>Tổng lượt gửi xe</th>
                        <th class="text-end pe-4">Doanh thu đóng góp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lx in Model.ThongKeTheoLoaiXe)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@lx.TenLoaiXe</td>
                            <td>@lx.SoLuongXe xe</td>
                            <td><span class="badge bg-light text-dark border">@lx.SoLuotGui lượt</span></td>
                            <td class="text-end pe-4 fw-bold text-success">@lx.DoanhThu.ToString("N0") VNĐ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function decodeHtml(html) {
                var txt = document.createElement("textarea");
                txt.innerHTML = html;
                return txt.value;
            }

           
            var revenueLabels = [];
            var revenueData = [];

            @foreach (var dt in Model.DoanhThuTheoThang.OrderBy(d => d.Nam).ThenBy(d => d.Thang))
            {
                    <text>
                        revenueLabels.push('Tháng @dt.Thang/@dt.Nam');
                        revenueData.push(@dt.TongTien);
                    </text>
            }

            var ctxRevenue = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRevenue, {
                type: 'bar',
                data: {
                    labels: revenueLabels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenueData,
                        backgroundColor: 'rgba(14, 165, 233, 0.75)',
                        borderColor: '#0284c7',
                        borderWidth: 2,
                        borderRadius: 6,
                        hoverBackgroundColor: 'rgba(2, 132, 199, 0.9)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + Number(context.raw).toLocaleString('vi-VN') + ' VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return Number(value).toLocaleString('vi-VN') + ' đ';
                                }
                            },
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

           
            var rawTypeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeTheoLoaiXe.Select(x => x.TenLoaiXe)));
            var typeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeTheoLoaiXe.Select(x => x.SoLuongXe)));

            var ctxType = document.getElementById('vehicleTypeChart').getContext('2d');
            new Chart(ctxType, {
                type: 'doughnut',
                data: {
                    labels: rawTypeLabels,
                    datasets: [{
                        data: typeData,
                        backgroundColor: [
                            '#3b82f6', 
                            '#10b981', 
                            '#f59e0b', 
                            '#8b5cf6'  
                        ],
                        borderWidth: 3,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15,
                                font: {
                                    size: 13,
                                    family: "'Plus Jakarta Sans', sans-serif"
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        });
    </script>
}