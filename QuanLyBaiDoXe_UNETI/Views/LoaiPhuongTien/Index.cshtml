@model IEnumerable<QuanLyBaiDoXe_UNETI.Models.LoaiPhuongTien>

@{
    ViewData["Title"] = "Quản lý loại phương tiện";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-truck text-primary me-2"></i>Quản lý Loại phương tiện
        </h3>
        <p class="text-muted mb-0 small">Thiết lập đơn giá đỗ xe theo giờ và cấu hình phương tiện hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Thêm loại mới</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã</th>
                        <th>Tên loại xe</th>
                        <th>Đơn giá / giờ</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th>Dữ liệu liên quan</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-bold">#@item.MaLoaiPhuongTien</td>
                            <td class="fw-semibold text-dark">@item.TenLoaiPhuongTien</td>
                            <td class="text-primary fw-bold">
                                @item.DonGiaTheoGio.ToString("N0") VNĐ/h
                            </td>
                            <td class="text-secondary small">@(string.IsNullOrEmpty(item.MoTa) ? "—" : item.MoTa)</td>
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i>Tạm khóa
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border me-1">
                                    <i class="bi bi-geo-alt text-primary"></i> @item.DanhSachViTri.Count vị trí
                                </span>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-bicycle text-success"></i> @item.DanhSachPhuongTien.Count xe
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.MaLoaiPhuongTien" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.MaLoaiPhuongTien" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa loại phương tiện này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>