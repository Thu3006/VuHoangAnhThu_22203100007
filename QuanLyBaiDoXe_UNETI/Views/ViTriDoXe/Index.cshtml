@model QuanLyBaiDoXe_UNETI.Models.ViTriDoXeIndexViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Quản lý & Tra cứu vị trí đỗ";
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-geo-alt-fill text-primary me-2"></i>Tra Cứu & Quản Lý Vị Trí Đỗ Xe
        </h3>
        <p class="text-muted mb-0 small">Tìm kiếm chỗ đỗ phù hợp theo loại xe, tầng, khu vực và trạng thái sử dụng</p>
    </div>
    @if (vaiTro == "Admin")
    {
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Thêm vị trí mới</span>
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ Lọc Đa Tiêu Chí (Filter + Search + Sort) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4 bg-white rounded-3">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Từ khóa tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Tên vị trí, khu vực..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Loại phương tiện</label>
                    <select name="maLoaiPhuongTien" asp-items="ViewBag.DanhSachLoaiXe" class="form-select">
                        <option value="">-- Tất cả loại --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Khu vực</label>
                    <select name="khuVuc" class="form-select">
                        <option value="">-- Tất cả khu vực --</option>
                        @foreach (var kv in ViewBag.DanhSachKhuVuc as List<string> ?? new List<string>())
                        {
                            <!option value="@kv" @(Model.KhuVuc == kv ? "selected" : "")>@kv</!option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label small fw-bold text-muted">Tầng</label>
                    <select name="tang" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var t in ViewBag.DanhSachTang as List<int> ?? new List<int>())
                        {
                            <!option value="@t" @(Model.Tang == t ? "selected" : "")>Tầng @t</!option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <!option value="Còn trống" @(Model.TrangThai == "Còn trống" ? "selected" : "")>Còn trống</!option>
                        <!option value="Đang sử dụng" @(Model.TrangThai == "Đang sử dụng" ? "selected" : "")>Đang sử dụng</!option>
                        <!option value="Tạm ngừng" @(Model.TrangThai == "Tạm ngừng" ? "selected" : "")>Tạm ngừng</!option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Sắp xếp</label>
                    <select name="sortOrder" class="form-select">
                        <!option value="" @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>Tên A ➜ Z</!option>
                        <!option value="name_desc" @(Model.SortOrder == "name_desc" ? "selected" : "")>Tên Z ➜ A</!option>
                        <!option value="tang_asc" @(Model.SortOrder == "tang_asc" ? "selected" : "")>Tầng tăng dần</!option>
                        <!option value="tang_desc" @(Model.SortOrder == "tang_desc" ? "selected" : "")>Tầng giảm dần</!option>
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a asp-action="Index" class="btn btn-light px-3"><i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại</a>
                <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-funnel-fill me-1"></i>Áp dụng lọc</button>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách hiển thị dạng Thẻ trực quan (Slot Cards) -->
<div class="row row-cols-1 row-cols-md-4 g-4 mb-4">
    @if (!Model.DanhSachViTri.Any())
    {
        <div class="col-12 w-100 text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-secondary mt-2">Không tìm thấy vị trí đỗ xe nào phù hợp với bộ lọc.</p>
        </div>
    }
    @foreach (var item in Model.DanhSachViTri)
    {
        var badgeColor = item.TrangThai switch
        {
            "Còn trống" => "bg-success",
            "Đang sử dụng" => "bg-danger",
            _ => "bg-secondary"
        };

        var borderCard = item.TrangThai switch
        {
            "Còn trống" => "border-success-subtle",
            "Đang sử dụng" => "border-danger-subtle",
            _ => ""
        };

        <div class="col">
            <div class="card h-100 shadow-sm border @borderCard position-relative">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="fw-bold mb-0 text-dark">@item.TenViTri</h4>
                        <span class="badge @badgeColor">@item.TrangThai</span>
                    </div>
                    <div class="text-muted small mb-1">
                        <i class="bi bi-truck text-primary me-1"></i>@(item.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Chung")
                    </div>
                    <div class="text-muted small mb-2">
                        <i class="bi bi-layers text-secondary me-1"></i>@item.KhuVuc - Tầng @item.Tang
                    </div>
                    <p class="card-text text-secondary small text-truncate">
                        @(string.IsNullOrEmpty(item.MoTa) ? "Không có mô tả" : item.MoTa)
                    </p>

                    @if (vaiTro == "Admin")
                    {
                        <div class="d-flex justify-content-end gap-1 mt-3 pt-2 border-top">
                            <a asp-action="Edit" asp-route-id="@item.MaViTri" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.MaViTri" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa vị trí này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    }
                    else if (item.TrangThai == "Còn trống")
                    {
                        <div class="mt-3 pt-2 border-top">
                            <a asp-controller="PhieuGuiXe" asp-action="DangKy" asp-route-maViTri="@item.MaViTri" class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-check-circle me-1"></i>Chọn vị trí này
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Phân trang Pagination (Giữ lại tất cả bộ lọc khi bấm chuyển trang) -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-maLoaiPhuongTien="@Model.MaLoaiPhuongTien"
                   asp-route-khuVuc="@Model.KhuVuc"
                   asp-route-tang="@Model.Tang"
                   asp-route-trangThai="@Model.TrangThai"
                   asp-route-sortOrder="@Model.SortOrder">
                    <i class="bi bi-chevron-left"></i> Trước
                </a>
            </li>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@p"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-maLoaiPhuongTien="@Model.MaLoaiPhuongTien"
                       asp-route-khuVuc="@Model.KhuVuc"
                       asp-route-tang="@Model.Tang"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-sortOrder="@Model.SortOrder">@p</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-maLoaiPhuongTien="@Model.MaLoaiPhuongTien"
                   asp-route-khuVuc="@Model.KhuVuc"
                   asp-route-tang="@Model.Tang"
                   asp-route-trangThai="@Model.TrangThai"
                   asp-route-sortOrder="@Model.SortOrder">
                    Sau <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    <div class="text-center text-muted small">
        Hiển thị trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> (Tổng số <strong>@Model.TotalItems</strong> vị trí đỗ)
    </div>
}