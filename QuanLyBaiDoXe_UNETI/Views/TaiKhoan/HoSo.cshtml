@model QuanLyBaiDoXe_UNETI.Models.TaiKhoan

@{
    ViewData["Title"] = "Thông tin cá nhân";
    var chuXe = ViewBag.ChuXe as QuanLyBaiDoXe_UNETI.Models.ChuPhuongTien;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-4 text-center">
                    <div class="d-inline-flex p-3 rounded-circle bg-white bg-opacity-25 mb-2">
                        <i class="bi bi-person-circle fs-1"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@Model.HoTen</h5>
                    <span class="badge bg-light text-primary mt-2">@(Model.VaiTro == "Admin" ? "Quản Trị Viên" : "Khách Hàng")</span>
                </div>
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-person-lines-fill text-primary me-2"></i>Chi tiết tài khoản
                    </h6>
                    <div class="row g-3 small mb-4">
                        <div class="col-sm-5 text-muted">Tên đăng nhập:</div>
                        <div class="col-sm-7 fw-semibold">@Model.TenDangNhap</div>

                        <div class="col-sm-5 text-muted">Hộp thư điện tử (Email):</div>
                        <div class="col-sm-7 fw-semibold">@Model.Email</div>

                        @if (chuXe != null)
                        {
                            <div class="col-sm-5 text-muted">Số điện thoại liên hệ:</div>
                            <div class="col-sm-7 fw-semibold">@(string.IsNullOrEmpty(chuXe.SoDienThoai) ? "Chưa cập nhật" : chuXe.SoDienThoai)</div>

                            <div class="col-sm-5 text-muted">Địa chỉ đăng ký:</div>
                            <div class="col-sm-7 fw-semibold">@(string.IsNullOrEmpty(chuXe.DiaChi) ? "Chưa cập nhật" : chuXe.DiaChi)</div>
                        }
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="DoiMatKhau" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                            <i class="bi bi-key-fill me-1"></i>Đổi mật khẩu
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-sm px-3">
                            Quay lại trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>