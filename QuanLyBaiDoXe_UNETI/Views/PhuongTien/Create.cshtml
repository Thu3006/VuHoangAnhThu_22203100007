@model QuanLyBaiDoXe_UNETI.Models.PhuongTien

@{
    ViewData["Title"] = "Đăng ký xe mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Đăng Ký Phương Tiện Mới
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="BienSoXe" class="form-label fw-semibold">Biển số xe <span class="text-danger">*</span></label>
                        <input asp-for="BienSoXe" class="form-control" placeholder="Ví dụ: 29A1-567.89, 30F-999.99..." />
                        <span asp-validation-for="BienSoXe" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaLoaiPhuongTien" class="form-label fw-semibold">Loại phương tiện <span class="text-danger">*</span></label>
                        <select asp-for="MaLoaiPhuongTien" asp-items="ViewBag.MaLoaiPhuongTien" class="form-select">
                            <option value="">-- Chọn loại xe --</option>
                        </select>
                        <span asp-validation-for="MaLoaiPhuongTien" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="NhanHieu" class="form-label fw-semibold">Nhãn hiệu xe</label>
                            <input asp-for="NhanHieu" class="form-control" placeholder="Ví dụ: Honda, Yamaha, VinFast..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MauSac" class="form-label fw-semibold">Màu sắc</label>
                            <input asp-for="MauSac" class="form-control" placeholder="Ví dụ: Trắng, Đen, Xanh..." />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MoTa" class="form-label fw-semibold">Ghi chú thêm</label>
                        <textarea asp-for="MoTa" rows="3" class="form-control" placeholder="Đặc điểm nhận dạng xe..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i>Lưu phương tiện
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}